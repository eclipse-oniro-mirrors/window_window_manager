import("//build/test.gni")
import("../../../windowmanager_aafwk.gni")

module_output_path = "window_manager/tools"

ohos_unittest("ohos_window_command_util_test") {
  branch_protector_ret = "pac_ret"

  module_out_path = module_output_path

  sources = [ "ohos_window_command_util_test.cpp" ]

  cflags_cc = [
    "-Dprivate = public",
    "-Dprotected = public",
  ]

  deps = [ "${window_base_path}/tools/ohos-window:ohos_window_cli_source_set" ]

  external_deps = [
    "ability_runtime:ability_manager",
    "c_utils:utils",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "hilog:libhilog",
    "image_framework:image_native",
    "ipc:ipc_single",
  ]

  subsystem_name = "window"
  part_name = "window_manager"
}