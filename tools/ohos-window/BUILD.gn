import("//build/config/python.gni")
import("//build/templates/cxx/cxx.gni")
import("//build/templates/common/copy.gni")
import("//build/ohos/cli/ohos_cli_executable.gni")
import("../../windowmanager_aafwk.gni")

config("ohos_window_command_config") {
  include_dirs = [ "include" ]
}

config("ohos_window_command_exception_config") {
  cflags_cc = [ "-fexceptions" ]
}

ohos_static_library("ohos_window_cli_source_set") {
  sources = [
    "src/ohos_window_command.cpp",
    "src/shell_command.cpp",
  ]

  sanitize = {
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  public_configs = [
    ":ohos_window_command_config",
    ":ohos_window_command_exception_config",
  ]

  public_deps = [
    "${window_base_path}/window_scene/session_manager:session_manager_lite",
  ]

  external_deps = [
    "ability_runtime:ability_manager",
    "c_utils:utils",
    "hilog:libhilog",
    "image_framework:image_native",
    "ipc:ipc_single",
    "json:nlohmann_json_static",
    "samgr:samgr_proxy",
  ]

  subsystem_name = "window"
  part_name = "window_manager"
}

ohos_cli_executable("ohos-window") {
  sources = [ "src/main.cpp" ]

  sanitize = {
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  deps = [ ":ohos_window_cli_source_set" ]

  external_deps = [
    "ability_runtime:ability_manager",
    "c_utils:utils",
    "hicollie:libhicollie",
    "hilog:libhilog",
    "image_framework:image_native",
    "ipc:ipc_single",
    "json:nlohmann_json_static",
  ]

  install_enable = true
  install_images = [ "system" ]
  cli_config_file = "ohos-window.json"
  subsystem_name = "window"
  part_name = "window_manager"
}

group("tools_ohos_window") {
  deps = [ ":ohos-window" ]
}

group("test") {
  testonly = true

  deps = [ "tests:ohos_window_command_util_test" ]
}